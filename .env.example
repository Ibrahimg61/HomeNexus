# Secrets for the Tapo API and the HomeNexus API key.
# Copy this file to .env and fill in real values. Never commit the real .env.
TAPO_EMAIL="your-email@example.com"
TAPO_PASSWORD="your-password"
HOMENEXUS_API_KEY="replace-me"
DATABASE_URL="file:/app/db-data/homenexus.db"
DATABASE_PATH="/app/db-data/homenexus.db"
